{
  "expo": {
    "name": "TaskFlow",
    "slug": "taskflow-mobile",
    "scheme": "taskflow",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "splash": {
      "backgroundColor": "#0b1020"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.taskflow.mobile"
    },
    "android": {
      "package": "com.taskflow.mobile"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "4a3f396f-5040-49f6-abb5-53aa5a760d19"
      }
    }
  }
}
